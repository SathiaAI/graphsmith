{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation-testing scope: scripts/gate.js (v0.5.0 mutation-testing gate follow-up, scoped run on 5 files with dedicated fast oracles). Scoped to this module (not the full backlog) because it has its own fast, comprehensive, dedicated test suite.",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "node tests/gate/grok/run-tests.js && node tests/gate/gpt-sol-pro/run-tests.js"
  },
  "mutate": [
    "scripts/gate.js"
  ],
  "reporters": ["html", "json", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation-gate/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-gate/mutation.json"
  },
  "concurrency": 24,
  "timeoutMS": 30000,
  "timeoutFactor": 3,
  "coverageAnalysis": "off"
}
