{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation-testing scope: scripts/writer-claim.js (v0.5.0 mutation-testing gate follow-up, Decision G Option 1 first baseline round). Scoped to this module because it has its own fast, comprehensive, dedicated test suite.",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "node tests/state-store/writer-claim/run-tests.js && node tests/state-store/writer-claim-shared-storage/run-tests.js"
  },
  "mutate": [
    "scripts/writer-claim.js"
  ],
  "reporters": ["html", "json", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation-writer-claim/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-writer-claim/mutation.json"
  },
  "concurrency": 16,
  "timeoutMS": 30000,
  "timeoutFactor": 3,
  "coverageAnalysis": "off"
}
